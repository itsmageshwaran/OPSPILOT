# ==============================================================================
# OpsPilot & ShopFlow Global Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.
# SECRETS MANAGEMENT POLICY:
# In production environments, all secrets (JWT_SECRET_KEY, PAYMENT_WEBHOOK_SECRET,
# LLM_API_KEY, DATABASE credentials) MUST be injected securely via environment
# variables, Kubernetes Secrets, or a dedicated vault (e.g. AWS Secrets Manager, HashiCorp Vault).
# Hardcoded insecure fallback credentials will cause startup failure in production mode.
# ==============================================================================

# Application Environment & Runtime
APP_NAME=OpsPilot
ENVIRONMENT=development
PORT=8080
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ShopFlow Monitored Target Configuration
SHOPFLOW_BASE_URL=http://127.0.0.1:8000
SHOPFLOW_TIMEOUT_SECONDS=5.0

# Database Configuration (SQL / SQLite / PostgreSQL)
# For SQLite (default WAL architecture):
DATABASE_URL=sqlite:///./opspilot.db
# For PostgreSQL (Enterprise production deployment):
# DATABASE_URL=postgresql://opspilot_user:secure_password@127.0.0.1:5432/opspilot

# MongoDB Knowledge Base Configuration (NoSQL)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=opspilot_kb

# Redis Caching Tier Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & JWT Secrets Management
# REQUIRED: Must be at least 32 characters in production.
JWT_SECRET_KEY=change-this-jwt-secret-in-production-env-to-32-random-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Payment Gateway Test-Mode & Webhook Secrets Management
# REQUIRED: Webhook signing secret used for HMAC-SHA256 signature verification.
PAYMENT_GATEWAY_API_KEY=sk_test_shopflow_mock_gateway_api_key_2026
PAYMENT_WEBHOOK_SECRET=whsec_test_mock_webhook_secret_shopflow_2026_strict

# Optional LLM Root Cause Analysis (OpenAI / Gemini compatible endpoint)
# If left empty, OpsPilot automatically uses deterministic topological RCA
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15.0
LLM_TEMPERATURE=0.1

# Remediation Safety Policy Configuration
REMEDIATION_ALLOWLIST_PATH=config/remediation_allowlist.yaml
REMEDIATION_ENABLED=true
REMEDIATION_SIMULATION_MODE=true

