# ==============================================================================
# ShopFlow Independent Microservice Platform (.env.example)
# ==============================================================================
ENVIRONMENT=production-simulation
APP_NAME=ShopFlow
VERSION=1.0.0
DEMO_MODE=true

# API Gateway
PORT=8000
HOST=0.0.0.0
GATEWAY_URL=http://127.0.0.1:8000
SHOPFLOW_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# PostgreSQL Simulation / In-Memory State
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=shopflow
POSTGRES_USER=shopflow_user
POSTGRES_PASSWORD=shopflow_dev_password

# Redis Simulation / Cache Tier
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT Auth Token Configuration
# SECRETS POLICY: Required in production. Minimum 32 alphanumeric bytes.
JWT_SECRET_KEY=change-this-jwt-secret-in-production-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Payment Gateway & Webhook Signature Secrets
PAYMENT_GATEWAY_API_KEY=sk_test_shopflow_mock_gateway_api_key_2026
PAYMENT_WEBHOOK_SECRET=whsec_test_mock_webhook_secret_shopflow_2026_strict
